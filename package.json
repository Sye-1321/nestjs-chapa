{
  "name": "@sye1321/nestjs-chapa",
  "version": "0.0.0",
  "private": true,
  "description": "Community-maintained NestJS integration foundation for Chapa",
  "license": "MIT",
  "type": "module",
  "engines": { "node": "^22.0.0 || ^24.0.0" },
  "packageManager": "pnpm@11.24.0",
  "files": ["dist", "README.md", "LICENSE", "CHANGELOG.md", "SECURITY.md"],
  "scripts": {
    "clean": "node scripts/m1-clean.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:tsc": "node scripts/m1-build-tsc.mjs",
    "build:tsdown": "tsdown --config tsdown.config.ts && tsdown --config tsdown.proof.config.ts",
    "proof:prepare:tsc": "node scripts/m1-prepare-candidate.mjs tsc",
    "proof:prepare:tsdown": "node scripts/m1-prepare-candidate.mjs tsdown",
    "proof:api": "node scripts/m1-api-extract.mjs",
    "proof:consumers": "node scripts/m1-consumer-proof.mjs",
    "proof:determinism": "node scripts/m1-determinism-proof.mjs"
  },
  "dependencies": { "zod": "4.4.3" },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "7.59.0",
    "@nestjs/common": "11.2.3",
    "@nestjs/core": "11.2.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tsdown": "0.22.14",
    "typescript": "5.9.3"
  }
}
