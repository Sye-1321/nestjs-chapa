{
  "name": "@sye1321/nestjs-chapa",
  "version": "0.0.0",
  "private": true,
  "description": "Community-maintained NestJS integration foundation for Chapa",
  "keywords": ["nestjs", "chapa", "payments", "ethiopia"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sye-1321/nestjs-chapa.git"
  },
  "bugs": {
    "url": "https://github.com/Sye-1321/nestjs-chapa/issues"
  },
  "homepage": "https://github.com/Sye-1321/nestjs-chapa#readme",
  "type": "module",
  "engines": { "node": "^22.0.0 || ^24.0.0" },
  "packageManager": "pnpm@11.24.0",
  "files": ["dist", "README.md", "LICENSE", "CHANGELOG.md", "SECURITY.md"],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/esm/testing/index.d.ts",
        "default": "./dist/esm/testing/index.js"
      },
      "require": {
        "types": "./dist/cjs/testing/index.d.ts",
        "default": "./dist/cjs/testing/index.js"
      }
    }
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node scripts/build.mjs",
    "api:check": "node scripts/api-check.mjs",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "test:foundation": "pnpm build && node --test test/foundation/*.test.mjs",
    "pack:check": "pnpm build && node scripts/pack-check.mjs",
    "test:consumers": "pnpm build && node scripts/test-consumers.mjs",
    "test": "pnpm typecheck && pnpm api:check && pnpm test:foundation && pnpm test:consumers"
  },
  "dependencies": { "zod": "4.4.3" },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.1",
    "@microsoft/api-extractor": "7.59.0",
    "@nestjs/common": "11.2.3",
    "@nestjs/core": "11.2.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typescript": "5.9.3"
  }
}
