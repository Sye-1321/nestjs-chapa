{
  "name": "@sye1321/nestjs-chapa",
  "version": "0.1.0-rc.0",
  "description": "Community-maintained NestJS integration for Chapa",
  "keywords": [
    "nestjs",
    "chapa",
    "payments",
    "ethiopia"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sye-1321/nestjs-chapa.git"
  },
  "bugs": {
    "url": "https://github.com/Sye-1321/nestjs-chapa/issues"
  },
  "homepage": "https://github.com/Sye-1321/nestjs-chapa#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "packageManager": "pnpm@11.24.0",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/esm/testing/index.d.ts",
        "default": "./dist/esm/testing/index.js"
      },
      "require": {
        "types": "./dist/cjs/testing/index.d.ts",
        "default": "./dist/cjs/testing/index.js"
      }
    }
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "format": "prettier --write src test scripts examples docs/guides README.md CONTRIBUTING.md GOVERNANCE.md package.json .changeset/config.json .github/workflows/*.yml",
    "format:check": "prettier --check src test scripts examples docs/guides README.md CONTRIBUTING.md GOVERNANCE.md package.json .changeset/config.json .github/workflows/*.yml",
    "lint": "eslint src test scripts examples",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.examples.json --noEmit",
    "build": "node scripts/build.mjs",
    "api:check": "node scripts/api-check.mjs",
    "determinism:check": "node scripts/determinism-check.mjs",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "test:packaging": "pnpm build && node --test test/packaging/*.test.mjs",
    "test:core": "pnpm build && node --test test/core/*.test.mjs",
    "test:payments": "pnpm build && node --test test/payments/*.test.mjs",
    "test:references": "pnpm build && node --test test/references/*.test.mjs",
    "test:metadata": "pnpm build && node --test test/metadata/*.test.mjs",
    "test:webhooks": "pnpm build && node --test test/webhooks/*.test.mjs",
    "test:nest": "pnpm build && node --test test/nest/*.test.mjs",
    "test:platform": "pnpm build && node --test test/platform/*.test.mjs",
    "test:built": "node --test test/packaging/*.test.mjs test/core/*.test.mjs test/payments/*.test.mjs test/references/*.test.mjs test/metadata/*.test.mjs test/webhooks/*.test.mjs test/nest/*.test.mjs test/platform/*.test.mjs",
    "test:coverage": "pnpm build && pnpm test:coverage:built",
    "test:coverage:built": "c8 --all --src dist/esm --include=dist/esm/**/*.js --include=src/**/*.ts --exclude=src/**/types.ts --exclude=src/core/contracts.ts --exclude-after-remap --reporter=text --check-coverage --statements 90 --lines 90 --functions 85 --branches 85 node --test test/core/*.test.mjs test/payments/*.test.mjs test/references/*.test.mjs test/metadata/*.test.mjs test/webhooks/*.test.mjs test/nest/*.test.mjs",
    "pack:check": "pnpm build && pnpm pack:check:built",
    "pack:check:built": "node scripts/pack-check.mjs",
    "test:consumers": "pnpm build && pnpm test:consumers:built",
    "test:consumers:built": "node scripts/test-consumers.mjs",
    "smoke:sandbox": "pnpm build && node scripts/sandbox-smoke.mjs",
    "test": "pnpm typecheck && pnpm build && pnpm test:built && pnpm test:consumers:built",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm clean && pnpm build && pnpm api:check && pnpm test:built && pnpm test:coverage:built && pnpm determinism:check && pnpm pack:check:built && pnpm test:consumers:built"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.1",
    "@eslint/js": "9.39.1",
    "@microsoft/api-extractor": "7.59.0",
    "@nestjs/common": "11.2.3",
    "@nestjs/core": "11.2.3",
    "@nestjs/platform-express": "11.2.3",
    "@nestjs/platform-fastify": "11.2.3",
    "@nestjs/testing": "11.2.3",
    "@types/node": "24.10.1",
    "@types/express": "5.0.6",
    "c8": "10.1.3",
    "eslint": "10.9.1",
    "express": "5.2.1",
    "fastify": "5.12.1",
    "prettier": "3.9.6",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0"
  }
}
